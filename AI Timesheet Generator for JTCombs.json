: 0, "node": "Get Today's Emails", "type": "main"}]]}, "Split Out": {"main": [[{"index": 0, "node": "Insert Sheets Entry", "type": "main"}]]}, "Split Out1": {"main": [[{"index": 0, "node": "Get Commits From Github", "type": "main"}]]}, "Split Out2": {"main": [[{"index": 0, "node": "Get GitHub PRs", "type": "main"}]]}}, "name": "AI Timesheet Generator (JTCombs)", "nodes": [{"id": "d3ad9729-1444-4227-b37e-b232546347de", "name": "Get Today's Calendar Events", "parameters": {"operation": "getAll", "options": {"timeMax": "={{$today.endOf('day').toISO()}}", "timeMin": "={{$today.startOf('day').toISO()}}"}, "returnAll": true}, "position": [-3220, -1300], "type": "n8n-nodes-base.googleCalendar", "typeVersion": 1, "credentials": {"googleCalendarOAuth2Api": {"id": "", "name": "Google Calendar - JTCombs"}}}, {"id": "cd793b22-bd54-430e-aa78-7a7e1f066f96", "name": "Get Today's Emails", "parameters": {"filters": {"receivedAfter": "={{ $now.startOf('day').toISO() }}", "sender": "={{ $json.myEmail }}"}, "operation": "getAll", "returnAll": true}, "position": [-3220, -1560], "type": "n8n-nodes-base.gmail", "typeVersion": 2, "webhookId": "0611a0b0-9e31-497f-98a9-7609c2287db1", "credentials": {"gmailOAuth2": {"id": "", "name": "Gmail - JTCombs"}}}, {"id": "8bdb5e00-ce98-4c75-94e4-d1c9f341a826", "name": "Get GitHub PRs", "parameters": {"getRepositoryPullRequestsFilters": {}, "operation": "getPullRequests", "owner": {"__rl": true, "mode": "name", "value": "={{ $('Set Variables').item.json.github_handle }}"}, "repository": {"__rl": true, "mode": "name", "value": "={{ $json.repositoriesToTrack }}"}, "resource": "repository", "returnAll": true}, "position": [-3320, -640], "type": "n8n-nodes-base.github", "typeVersion": 1, "webhookId": "0ec33ec2-fbb5-4b63-afd2-7227a8dba1c4", "credentials": {"githubApi": {"id": "", "name": "GitHub - JTCombs"}}}, {"id": "201ef564-57e6-4fde-8251-459c56ef05d0", "name": "Format All Data", "parameters": {"jsCode": "// Get all data from different sources\nconst allInputs = $input.all();\nconst calendarEvents = allInputs.find(b => b.json.calendarEvents)?.json.calendarEvents || [];\nconst emails = allInputs.find(b => b.json.emails)?.json.emails || [];\nconst commits = allInputs.find(b => b.json.commits)?.json.commits || [];\nconst prs = allInputs.find(b => b.json.prs)?.json.prs || [];\n\n// Format calendar events\nconst confirmed = calendarEvents.filter(e => e.status === 'confirmed');\n\nconst calendarSummary = confirmed.map(event => {\n  let duration = 0;\n  try {\n    if (event.start?.dateTime && event.end?.dateTime) {\n      duration = DateTime.fromISO(event.end.dateTime).diff(DateTime.fromISO(event.start.dateTime), 'hours').hours;\n    }\n  } catch (e) {}\n  return {\n    time: event.start?.dateTime || event.start?.date || 'No time',\n    title: event.summary || 'No title',\n    attendees: event.attendees?.length || 0,\n    description: event.description || 'No description',\n    duration: Math.round(duration * 100) / 100\n  };\n});\n\n// Format emails (filter out unimportant ones)\nconst importantEmails = emails\n  .filter(email => \n    email.From && \n    !email.From.toLowerCase().includes('noreply') && \n    !email.Subject?.toLowerCase().includes('newsletter')\n  )\n  .slice(0, 20)\n  .map(email => ({\n    from: email.From,\n    subject: email.Subject || 'No subject',\n    snippet: email.snippet?.substring(0, 100) || ''\n  }));\n\nconst commitArray = Array.isArray(commits) ? commits : [commits];\nconst prsArray = Array.isArray(prs) ? prs : [prs];\n// Format GitHub activity\nconst githubActivity = {\n  commits: commitArray.filter(c => c && c.commit).map(commit => ({\n    message: commit.commit?.message || 'No message'\n  })),\n  pullRequests: prsArray.filter(p => p && p.title).map(pr => ({\n    title: pr.title,\n    repo: pr.head?.repo?.name || 'Unknown repo',\n    state: pr.state\n  }))\n};\n\n// Create summary object\nconst summary = {\n  date: $('Set Variables').first().json.today_date,\n  calendar: {\n    totalEvents: calendarSummary.length,\n    events: calendarSummary\n  },\n  emails: {\n    totalReceived: emails.length,\n    important: importantEmails\n  },\n  github: githubActivity\n};\n\nreturn [{ json: summary }];"}, "typeVersion": 1, "position": [-2320, -1080], "type": "n8n-nodes-base.code"}, {"id": "9a9385f0-ca86-457f-b599-713a809aa423", "name": "Generate Journal Summary", "parameters": {"jsonOutput": true, "messages": {"values": [{"content": "You are a professional timesheet creator.\n\nINPUT you receive: a single JSON object that contains:\n  \u2022 calendar.events          (array)\n  \u2022 emails.important         (array)\n  \u2022 github.commits           (array)\n  \u2022 github.pullRequests      (array)\n\nTASK\n1. Walk through every element in those arrays.\n2. For each element create an object that has **exactly**:\n     - \"type\"        : CALENDAR_EVENT | EMAIL | COMMIT | PR\n     - \"description\" : \u2264120 chars, no commas, no line-breaks\n3. Put all objects in one JSON **array**.\n4. RETURN  that array. No wrapper object, no markdown. Try to create a nice description for each event", "role": "system"}, {"content": "=Below is today\u2019s raw data in one JSON object.\n\n{{ JSON.stringify($json, null, 2) }}\n"}]}, "modelId": {"__rl": true, "cachedResultName": "GPT-4O-MINI", "mode": "list", "value": "gpt-4o-mini"}, "options": {}}, "position": [-2100, -1080], "type": "@n8n/n8n-nodes-langchain.openAi", "typeVersion": 1, "credentials": {"openAiApi": {"id": "", "name": "OpenAI - JTCombs"}}}, {"id": "34e60115-851c-4055-b1bc-3bba3076fefe", "name": "Aggregate", "parameters": {"aggregate": "aggregateAllItemData", "destinationFieldName": "emails", "options": {}}, "position": [-2940, -1560], "type": "n8n-nodes-base.aggregate", "typeVersion": 1}, {"id": "a1dbd248-1cd5-4fec-8198-52573fbe50ed", "name": "Merge", "parameters": {"numberInputs": 4}, "position": [-2540, -1101], "type": "n8n-nodes-base.merge", "typeVersion": 3.2}, {"id": "53ab1990-ddeb-410f-8cd4-675ed88387a9"